{
  "name": "astha-chopa",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, pass-and-play Ashta Chamma (Chowka Bara) for 1-4 players on one phone, with bot opponents. Expo + React Native.",
  "author": "Rachit Tyagi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachittyagi/astha-chopa.git"
  },
  "homepage": "https://github.com/rachittyagi/astha-chopa#readme",
  "bugs": {
    "url": "https://github.com/rachittyagi/astha-chopa/issues"
  },
  "keywords": [
    "ashta-chamma",
    "chowka-bara",
    "board-game",
    "indian-games",
    "expo",
    "react-native",
    "offline-game"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "audit:deps": "tsx scripts/audit-deps.ts",
    "sim": "tsx scripts/simulate.ts",
    "e2e": "maestro test .maestro",
    "rules:coverage": "tsx scripts/rule-coverage.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.5.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-i18next": "^6.1.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-native-web": "^0.21.4",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.13.1"
